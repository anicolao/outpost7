#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/anicolao/projects/antigravity/games/outpost7" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/anicolao/projects/antigravity/games/outpost7")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/anicolao/projects/antigravity/games/outpost7" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/anicolao/projects/antigravity/games/outpost7/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/anicolao/projects/antigravity/games/outpost7/.envrc" "/Users/anicolao/projects/antigravity/games/outpost7/.direnv"/*.rc
