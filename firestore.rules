rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /games/{gameId}/events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /cardSets/{cardSetId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'source', 'cardCount', 'createdBy', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 500000
        && request.resource.data.cardCount is int
        && request.resource.data.cardCount > 0
        && request.resource.data.cardCount <= 200
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
