{
  "name": "outpost7",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --project outpost7-e2e --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --project outpost7-e2e --only auth,firestore \"playwright test\"",
    "test:e2e:update-snapshots": "firebase emulators:exec --project outpost7-e2e --only auth,firestore \"playwright test --update-snapshots\"",
    "pre-commit": "if grep -r 'waitForTimeout' src tests; then echo 'Error: waitForTimeout is banned. Use waitForAnimations instead.' && exit 1; fi && npm run test:unit && npm run test:rules && npm run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.40.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/seedrandom": "^3.0.8",
    "firebase-tools": "^15.25.0",
    "husky": "^9.1.7",
    "svelte": "^5.0.0-next.1",
    "svelte-check": "^3.6.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "clsx": "^2.0.0",
    "firebase": "^12.17.1",
    "qrcode": "^1.5.4",
    "redux": "^5.0.0",
    "seedrandom": "^3.0.5"
  }
}
